# ==============================================================================
# THE SERVICE'S DEPLOYMENT CONFIGURATION -- A TEMPLATE, NOT A SECRET
#
# This file is committed on purpose. It holds no secret: values marked
# __FROM_SECRET__ are references that the fleet's deploy script resolves from
# Secrets Manager just before the container starts, into a scratch copy that is
# deleted afterwards.
#
# The pipeline replaces the remaining __PLACEHOLDERS__ before publishing:
#
#   __SERVICE_NAME__     the service's name
#   __SERVICE_DOMAIN__   the domain the service is served on
#   __DATABASE_HOST__    the database host, from the platform contract
#   __DATABASE_PORT__    the engine's port, published by the platforms team
#   __APP_SECRET_ARN__   the ARN of this service's secret
#
# Secret reference forms:
#   KEY=__FROM_SECRET__:ARN_VARIABLE            reads the field named after KEY, lowercased
#   KEY=__FROM_SECRET__:ARN_VARIABLE:field      reads an explicitly named field
# ==============================================================================

SERVICE_NAME=__SERVICE_NAME__

DJANGO_ALLOWED_HOSTS=__SERVICE_DOMAIN__
DJANGO_CSRF_TRUSTED_ORIGINS=https://__SERVICE_DOMAIN__
DJANGO_LOG_LEVEL=INFO

DATABASE_ENGINE=postgres
DATABASE_HOST=__DATABASE_HOST__
DATABASE_PORT=__DATABASE_PORT__

# The service's own secret: one JSON object holding the Django secret key and the
# database credentials the platform provisioned for it.
APP_SECRET_ARN=__APP_SECRET_ARN__

DJANGO_SECRET_KEY=__FROM_SECRET__:APP_SECRET_ARN
DATABASE_NAME=__FROM_SECRET__:APP_SECRET_ARN:db_name
DATABASE_USERNAME=__FROM_SECRET__:APP_SECRET_ARN:db_user
DATABASE_PASSWORD=__FROM_SECRET__:APP_SECRET_ARN:db_password
