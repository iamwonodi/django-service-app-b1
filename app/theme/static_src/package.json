{
  "name": "theme",
  "version": "4.5.0",
  "private": true,
  "description": "Tailwind CSS v4 build for the Django templates. Built by the Dockerfile's Node stage; nothing here ships in the image.",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:clean && npm run build:tailwind",
    "build:clean": "rimraf ../static/css/dist",
    "build:tailwind": "cross-env NODE_ENV=production postcss ./src/styles.css -o ../static/css/dist/styles.css --minify",
    "dev": "cross-env NODE_ENV=development postcss ./src/styles.css -o ../static/css/dist/styles.css --watch"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.28",
    "postcss-cli": "^11.0.1",
    "postcss-nested": "^8.0.1",
    "postcss-simple-vars": "^7.0.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3"
  }
}
