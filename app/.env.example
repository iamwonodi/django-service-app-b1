# ==============================================================================
# VARIABLES FOR LOCAL DEVELOPMENT ONLY -- NO SECRETS HERE
#
# NOT the deployment template: ".env" next to this file is that, and the pipeline
# publishes it. Nothing reads this file by itself; copy it to a name that is
# ignored by Git and load it into the shell that runs Django:
#
#   cp .env.example .env.local
#   set -a; . ./.env.local; set +a
#   python manage.py migrate && python manage.py runserver
#
# Every variable is optional: config.settings.development starts with none set
# (DEBUG on, SQLite, a built-in secret key, localhost allowed). manage.py uses
# that module unless DJANGO_SETTINGS_MODULE says otherwise.
#
# A deployed container never uses it: it runs config.settings.production, with its
# variables from the service's .env and Secrets Manager.
# ==============================================================================

# The settings module. Leave unset for development.
# DJANGO_SETTINGS_MODULE=config.settings.development

# Names the service; STATIC_URL becomes /static/<SERVICE_NAME>/.
# SERVICE_NAME=app

# DEBUG is on in development. Set it to false to see how a page behaves without it
# (the secret key and allowed hosts must then be set as well).
# DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=
# DJANGO_LOG_LEVEL=INFO

# SQLite is the default, in db.sqlite3 beside manage.py. To develop against a
# local PostgreSQL instead:
# DATABASE_ENGINE=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=app
# DATABASE_USERNAME=app
# DATABASE_PASSWORD=
